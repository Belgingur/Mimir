# Required: MapTiler key for the Positron basemap.
VITE_MAPTILER_KEY=your-maptiler-key

# Optional: origin that serves the /forecast-data forecast catalog.
# Leave empty to load forecast data from this app's own origin.
VITE_INHOUSE_ROOT=

# Base URL for Belgingur wavegram PNG endpoints.
VITE_BELGINGUR_BASE_URL=https://wod.belgingur.is

# ── Optional: meteogram feature ──────────────────────────────────────────────
# Click-the-map (desktop) / crosshair-button (mobile) forecast meteogram popup.
# The widget uses these as HTTP Basic auth credentials for its forecast-data
# requests, and their presence also gates the feature: it is enabled ONLY when
# BOTH are set. Leave them empty and the feature — code, CSS, and modal — is
# stripped from the build entirely.
VITE_WOD_API_USER=
VITE_WOD_API_PASSWORD=

# Optional: origin of the WOD API the bundled <bel-meteogram> widget fetches
# its config + forecast data from. Defaults to https://wod-odinn.belgingur.is
# (the legacy VITE_METEOGRAM_EMBED_URL is still honoured — its origin is used).
VITE_METEOGRAM_API_BASE=
